{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 8,
    "passthrough": false,

    // Define os módulos por seção
    "modules-left": ["hyprland/workspaces","cava","tray"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "battery", "pulseaudio"],

    // Configuração do Relógio
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "󰃭 {:%Y-%m-%d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    // Configuração do Áudio (PipeWire/PulseAudio)
    "pulseaudio": {
        "format": "vol: {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    // Configuração de Uso de CPU
    "cpu": {
        "format": "cpu: {usage}%",
        "interval": 2
    },

    // Configuração de Memória RAM
    "memory": {
        "format": "mem: {}%"
    },

    // Módulo dos Workspaces Corrigido
  // Exemplo de posição na barra

  // Bloco de configuração do módulo
  
  "hyprland/workspaces": {
	"active-only": false,
	"all-outputs": true,
	"format": "{name}",
	"show-special": false,
	"on-click": "hyprctl dispatch workspace {name}",
	"on-scroll-up": "hyprctl dispatch workspace e+1",
	"on-scroll-down": "hyprctl dispatch workspace e-1",
    "persistent-workspaces": {
      "*": [1,2,3]
	}
   },
   "cava": {
    // "cava_config": "/home/usuario/.config/cava/config", // Opcional: usa config externo do CAVA
    "framerate": 60,
    "autosens": 1,
    "sensitivity": 100,
    "bars": 12,
    "lower_cutoff_freq": 50,
    "higher_cutoff_freq": 10000,
    "method": "pipewire", // "pipewire", "pulseaudio" ou "alsa"
    "source": "auto",
    "stereo": true,
    "reverse": false,
    "bar_delimiter": 0,
    "monstercat": false,
    "waves": false,
    "noise_reduction": 0.77,
    "input_delay": 2,
    "format-icons": [" ", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    }
}
    
